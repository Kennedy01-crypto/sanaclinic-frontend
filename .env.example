# Browser-facing same-origin proxy path; Next.js forwards it to Django.
NEXT_PUBLIC_API_URL=/backend-api

# Django API origin used by the Next.js rewrite. Set this in Vercel project
# environment variables for production and preview deployments.
DJANGO_API_PROXY_TARGET=http://localhost:8000

# Django backend origin, used for cookie-based authentication requests.
NEXT_PUBLIC_DJANGO_URL=http://localhost:8000
